<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet">
{{ 'rosenberg.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<!-- Bandeau du haut : avantages, compte à rebours, liens -->
<div class="topbar">
  <div class="wrap topbar-in">
    <ul class="perks">
      <li><svg viewBox="0 0 24 24"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>Livraison offerte dès 500 €</li>
      <li><svg viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 7V4h8v3"/></svg>Paiement en 3x / 4x</li>
      <li><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>Garantie 2 ans</li>
    </ul>
    <div class="countdown" aria-label="Offre limitée" data-end="2026-10-31T23:59:59">
      <strong>-15 %<br>en plus</strong>
      <span><b id="cd-d">00</b>Jours</span>
      <span><b id="cd-h">00</b>Heures</span>
      <span><b id="cd-m">00</b>Min</span>
      <span><b id="cd-s">00</b>Sec</span>
    </div>
    <ul class="toplinks">
      <li><a href="/pages/contact">Showroom</a></li>
      <li><a href="/pages/contact">Aide</a></li>
    </ul>
  </div>
</div>

<!-- En-tête : logo, recherche, compte, favoris, panier -->
<header class="header">
  <div class="wrap header-in">
    <a class="logo" href="{{ routes.root_url }}">ROSENBERG<small>MAISON</small></a>
    <form class="search" action="/search" method="get">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" name="q" placeholder="Fauteuil, bac, table de soin…" aria-label="Rechercher">
    </form>
    <div class="actions">
      <a href="/account" class="account"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4-6 8-6s7 2 8 6"/></svg><span>Mon compte</span></a>
      <a href="/pages/wishlist" aria-label="Favoris"><svg viewBox="0 0 24 24"><path d="M12 20s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 6-8 11-8 11z"/></svg></a>
      <a href="{{ routes.cart_url }}" aria-label="Panier"><svg viewBox="0 0 24 24"><path d="M3 4h2l2.5 11h11L21 7H6.5"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>{% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </div>
  <nav class="nav">
    <div class="wrap">
      <ul>
        <li><a href="/collections/fauteuil-barber">Fauteuils barbier</a></li>
        <li><a href="/collections/fauteuil-coiffeur-femme">Fauteuils coiffure</a></li>
        <li><a href="/collections/bac-a-shampoing-barber">Bacs à shampoing</a></li>
        <li><a href="/collections/head-spa-esthetique">Head spa</a></li>
        <li><a href="/collections/table-de-soin-esthetique">Tables de soin</a></li>
        <li><a href="/collections/fauteuils-pedicure-esthetique">Pédicure</a></li>
        <li><a href="/collections/accueil-barber">Accueil</a></li>
        <li><a href="/collections/skincare">Skincare</a></li>
        <li><a class="hot" href="/collections/best-sellers">Nouveautés</a></li>
      </ul>
    </div>
  </nav>
</header>

<main>
{{ content_for_layout }}
</main>
<footer class="footer">
  <div class="wrap">
    <div class="newsletter">
      <div>
        <h3>Recevez nos offres pros</h3>
        <p>Nouveautés, ventes privées et conseils d'aménagement, une fois par mois.</p>
      </div>
      {% form 'customer', class: 'nl-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {% if form.posted_successfully? %}<p class="nl-ok">Merci, vous êtes inscrit.</p>{% else %}
        <input type="email" name="contact[email]" placeholder="Votre e-mail" aria-label="Votre e-mail" required>
        <button class="btn btn-gold" type="submit">Je m'inscris</button>{% endif %}
      {% endform %}
    </div>

    <div class="cols">
      <div class="contact">
        <h4>Nous contacter</h4>
        <p><i><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg></i><span>Par téléphone<br><b>Du lundi au vendredi</b></span></p>
        <p><i><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .8-1 1.5V14M12 17h.01"/></svg></i><span>Centre d'aide<br><b>maison-rosenberg.com/faq</b></span></p>
        <p><i><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z"/><path d="M3 6l9 7 9-7"/></svg></i><span>Par e-mail<br><b>maisonrosenberg@gmail.com</b></span></p>
      </div>
      <div>
        <h4>Coiffure &amp; barbier</h4>
        <a href="/collections/fauteuil-barber">Fauteuils barbier</a>
        <a href="/collections/fauteuil-coiffeur-femme">Fauteuils coiffure</a>
        <a href="/collections/bac-a-shampoing-barber">Bacs à shampoing</a>
        <a href="/collections/poste-de-coiffage-barber">Postes de coiffage</a>
        <a href="/collections/accueil-barber">Mobilier d'accueil</a>
      </div>
      <div>
        <h4>Esthétique</h4>
        <a href="/collections/head-spa-esthetique">Head spa</a>
        <a href="/collections/table-de-soin-esthetique">Tables de soin</a>
        <a href="/collections/fauteuils-pedicure-esthetique">Pédicure</a>
        <a href="/collections/fauteuil-de-massage-esthetique">Massage</a>
        <a href="/collections/tables-manucures-esthetique">Manucure</a>
        <a href="/collections/skincare">Skincare</a>
      </div>
      <div>
        <h4>La maison</h4>
        <a href="/pages/about">Qui sommes-nous</a>
        <a href="/pages/contact">Contact</a>
        <a href="/blogs/news">Blog</a>
        <a href="/policies/privacy-policy">Confidentialité</a>
      </div>
      <div>
        <h4>Infos pratiques</h4>
        <a href="/policies/shipping-policy">Livraison</a>
        <a href="/policies/refund-policy">Retours</a>
        <a href="/pages/contact">Garantie</a>
        <a href="/policies/terms-of-service">CGV</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>Paiement sécurisé : CB, Visa, Mastercard, PayPal, paiement en plusieurs fois</p>
      <div class="social">
        <span>Suivez-nous</span>
        <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg></a>
        <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a>
        <a href="#" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M14 3v11a3.5 3.5 0 1 1-3-3.5M14 3c.5 3 2.5 5 5 5"/></svg></a>
      </div>
    </div>
    <p class="copy">© {{ "now" | date: "%Y" }} {{ shop.name }}. Tous droits réservés.</p>
  </div>
</footer>

<button class="to-top" aria-label="Haut de page" onclick="scrollTo({top:0,behavior:'smooth'})">&#8593;</button>
<script>
(function(){
  var el=document.querySelector('.countdown'); if(!el) return;
  var end=new Date(el.dataset.end||'2026-10-31T23:59:59');
  function pad(n){return String(n).padStart(2,'0')}
  (function tick(){
    var s=Math.max(0,Math.floor((end-Date.now())/1000));
    var v=[Math.floor(s/86400),Math.floor(s/3600)%24,Math.floor(s/60)%60,s%60];
    ['d','h','m','s'].forEach(function(k,i){var e=document.getElementById('cd-'+k); if(e) e.textContent=pad(v[i])});
    setTimeout(tick,1000);
  })();
  document.querySelectorAll('[data-scroll]').forEach(function(b){b.onclick=function(){var t=b.parentNode.querySelector('.track');t.scrollBy({left:b.dataset.scroll*t.clientWidth*.8,behavior:'smooth'})}});
})();
</script>
</body>
</html>
