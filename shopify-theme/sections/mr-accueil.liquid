    { "type": "collection", "id": "tile_3", "label": "Tuile 3" },
    { "type": "collection", "id": "tile_4", "label": "Tuile 4" },
    { "type": "collection", "id": "tile_5", "label": "Tuile 5" }
  ],
  "presets": [{ "name": "Accueil Rosenberg" }]
}
